# homelab-template configuration.
# Copy to `.env` (cp .env.example .env), fill in, never commit `.env`.
# Empty secrets (tokens) are generated by setup.sh / setup.ps1 on first run.

# --- Raspberry Pi -----------------------------------------------------------
# Folder this repo is cloned to on the Pi (scripts, systemd units and cron use it).
HL_DIR=/home/pi/homelab-template
# Linux user that runs the dashboard and the user cron jobs.
HL_USER=pi

# Tailscale MagicDNS name of the Pi (see `tailscale status`), used by the PC
# scripts and the README links. Example: homelab.your-tailnet.ts.net
TS_HOST=homelab.example.ts.net

# --- Dashboard ----------------------------------------------------------------
DASHBOARD_PORT=3000
# 127.0.0.1 = only reachable through `tailscale serve` (recommended).
# 0.0.0.0 would expose it to every device on your LAN without a login.
DASHBOARD_HOST=127.0.0.1
# Bearer token for machine-to-machine writes (PC heartbeat). Generated if empty.
DASHBOARD_TOKEN=
# systemd units shown on the dashboard and checked by the Kuma push.
WATCH_SERVICES="dashboard tailscaled docker"

# --- Uptime Kuma --------------------------------------------------------------
KUMA_PORT=3001
# Push-monitor tokens. Generated if empty; pi/kuma/add-monitors.py creates the
# matching monitors in Kuma once you made the admin account.
KUMA_PUSH_SERVICES=
KUMA_PUSH_DISK=
KUMA_PUSH_BACKUP=
KUMA_PUSH_PC=
KUMA_PUSH_PC_BACKUP=

# --- Telegram (optional) -----------------------------------------------------
# Bot token from @BotFather, chat id of the group/user that gets alerts.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
# Forum topic id inside a group (optional).
TELEGRAM_THREAD_ID=

# --- Backups and health -----------------------------------------------------
# Pi: rolling SQLite backups, one per weekday (7 files per database).
BACKUP_DIR=/home/pi/backups
# Disk checked by pi/health/disk-health.sh (smartctl). USB-SATA bridges often need "-d sat".
DISK_DEVICE=/dev/sda
SMART_ARGS="-d sat"
# Firewall: these TCP ports only answer on lo and tailscale0 (comma separated).
LOCKED_PORTS=3000,3001

# --- Windows PC ---------------------------------------------------------------
# ssh target of the Pi as seen from the PC (Tailscale name or ssh config alias).
PI_SSH=pi@homelab.example.ts.net
# Where the PC keeps copies of the Pi backups.
PC_BACKUP_DIR='D:\Backups\homelab'
# Optional: dashboard address if you do not use `tailscale serve` (default https://TS_HOST).
DASHBOARD_URL=
# Drive whose free space the heartbeat reports (warns below 10 %).
PC_WATCH_DRIVE=C
